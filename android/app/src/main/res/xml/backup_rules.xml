<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 6-11 (android:fullBackupContent).
  Everything is backed up as before except flutter_secure_storage's files:
  they hold the Java session token, encrypted with a Keystore key that a
  restored device does not have, so a restored copy could never be read.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
</full-backup-content>
